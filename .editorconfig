root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Prose paragraphs use editor soft wrapping. This is not a code line limit.
[*.{md,qmd,R,r}]
max_line_length = off

# Preserve intentional Markdown hard breaks in structured content.
[*.{md,qmd}]
trim_trailing_whitespace = false
